{
  "name": "alvstore",
  "private": true,
  "version": "1.0.0",
  "description": "ALV Store \u2014 ERP & storefront. Next.js frontend + Express/Prisma/PostgreSQL backend (see server/).",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 -p 3000",
    "lint": "npm run check:ui",
    "dev:backend": "npm --prefix server run dev",
    "dev:db": "npm --prefix server run db:dev",
    "dev:all": "concurrently -n web,api,db \"npm run dev\" \"npm --prefix server run dev\" \"npm --prefix server run db:dev\"",
    "db:setup": "npm --prefix server run db:setup",
    "dev:https": "next dev --hostname 0.0.0.0 --experimental-https -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm --prefix server test",
    "check:ui": "node tools/check-ui.mjs",
    "test:unit": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:db": "npm --prefix server run test:db",
    "check": "npm run check:ui && npm run typecheck && npm test"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/server": "^11.11.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.10.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "@tanstack/react-query": "^5.83.0",
    "date-fns": "^3.6.0",
    "framer-motion": "^11",
    "gsap": "3.12.5",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.462.0",
    "next": "^15.5.4",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.61.1",
    "recharts": "^2.15.4",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.6",
    "typescript": "^5.8.3"
  }
}
