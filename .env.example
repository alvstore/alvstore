# Next.js web app
# Secret for Auth.js session JWTs (generate: openssl rand -base64 32)
AUTH_SECRET="generate-a-random-secret"
# Where the Next.js server can reach the Express API (server-side only).
# The browser always talks to /api/backend/* on this origin, which Next.js
# proxies to the API server (see next.config.mjs rewrites).
API_SERVER_URL="http://127.0.0.1:4000"
