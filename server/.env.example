# ALV Store backend
PORT=4000

# Postgres connection.
# - Production: point at your PostgreSQL, e.g.
#   DATABASE_URL="postgres://user:password@host:5432/alvstore"
# - Local dev (default): embedded PGlite served by `npm run db:dev`
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/postgres"

# Auth
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="30d"

# Optional integrations
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
SMTP_URL=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
