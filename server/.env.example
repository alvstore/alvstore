# ALV Store backend
PORT=4000

# Postgres connection.
# - Production: point at your PostgreSQL, e.g.
#   DATABASE_URL="postgres://user:password@host:5432/alvstore"
# - Local dev (default): embedded PGlite served by `npm run db:dev`
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/postgres"

# Auth
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="30d"
# Public web origin used when generating links. Use HTTPS in deployments.
APP_ORIGIN="http://localhost:3000"
# First setup only: re-seeding never resets an existing password.
ADMIN_EMAIL="admin@alvstore.in"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="ALV Admin"
# Optional embedded database overrides (socket port must match DATABASE_URL):
# PGLITE_SOCKET_PORT=5433
# PGLITE_DATA_DIR="/path/to/local-data"

# Optional integrations
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
SMTP_URL=""
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Email — send-email function (generic HTTP mail API: POST https://{SMTP_HOST}/send)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS — send-sms function + whatsapp-automation fallback (generic provider)
SMS_API_URL=""
SMS_API_KEY=""
SMS_SENDER_ID=""
SMS_DLT_ENTITY_ID=""

# Hik-Partner Cloud — hikvision-sync / hikvision-webhook functions
HIK_PARTNER_APP_KEY=""
HIK_PARTNER_SECRET_KEY=""
HIK_WEBHOOK_SIGN_SECRET=""

# AI gateway for parse-offer-pdf (OpenAI-compatible; heuristic parser when unset)
AI_GATEWAY_URL=""
AI_GATEWAY_KEY=""
AI_MODEL="gpt-4o-mini"

# Self-hosted WhatsApp gateway (OpenWA / Evolution API v2) — optional fallback if not configured in Settings
# WHATSAPP_PROVIDER="openwa"
# WHATSAPP_GATEWAY_URL="http://127.0.0.1:2785"
# WHATSAPP_GATEWAY_KEY=""
# WHATSAPP_INSTANCE="alvstore"
# WHATSAPP_WEBHOOK_SECRET=""
