{
  "name": "alvstore-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "ALV Store backend — Express + Prisma + PostgreSQL (replaces Supabase)",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:dev": "tsx tools/dev-db.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "db:bootstrap": "tsx tools/bootstrap-db.ts",
    "db:introspect": "tsx tools/introspect.ts",
    "db:seed": "tsx tools/seed.ts",
    "db:setup": "tsx tools/bootstrap-db.ts && tsx tools/introspect.ts && sh tools/prisma-cli.sh generate && tsx tools/seed.ts",
    "prisma:generate": "sh tools/prisma-cli.sh generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^6.8.2",
    "@prisma/client": "^6.8.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@electric-sql/pglite-socket": "^0.0.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "prisma": "^6.8.2",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
