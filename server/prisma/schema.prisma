// Source of truth for the ALV Store database. Apply with `npm run db:push`.

generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "auth"]
}

enum AppRole {
  admin
  staff
  technician
  customer

  @@map("app_role")
  @@schema("public")
}

enum AttendanceSource {
  manual
  biometric

  @@map("attendance_source")
  @@schema("public")
}

enum JobSheetStatus {
  created
  pending_approval
  approved
  rejected
  assigned
  in_progress
  waiting_parts
  repair_completed
  quality_check
  invoice_generated
  delivered
  qc_failed
  ready_for_delivery

  @@map("job_sheet_status")
  @@schema("public")
}

enum PaymentMethodType {
  cash
  card
  upi
  online

  @@map("payment_method_type")
  @@schema("public")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded

  @@map("payment_status")
  @@schema("public")
}

enum PaymentType {
  invoice
  pos
  online

  @@map("payment_type")
  @@schema("public")
}

enum QuotationStatus {
  draft
  sent
  accepted
  rejected
  expired

  @@map("quotation_status")
  @@schema("public")
}

enum RepairPriority {
  low
  normal
  high
  urgent

  @@map("repair_priority")
  @@schema("public")
}

enum RepairStatus {
  pending
  assigned
  in_progress
  waiting_parts
  completed
  delivered

  @@map("repair_status")
  @@schema("public")
}

enum StockMovementType {
  in
  out
  adjustment

  @@map("stock_movement_type")
  @@schema("public")
}

enum TemplateType {
  email
  sms
  invoice
  quotation

  @@map("template_type")
  @@schema("public")
}

model AppleOffers {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  offer_type           String
  bank_name            String?
  applicable_category  String
  applicable_product   String?
  discount_amount      Decimal?  @default(dbgenerated("0")) @db.Decimal
  discount_description String?
  start_date           DateTime? @db.Date
  end_date             DateTime? @db.Date
  status               String?   @default(dbgenerated("'active'::text"))
  created_at           DateTime? @default(now()) @db.Timestamptz(6)

  @@map("apple_offers")
  @@schema("public")
}

model ApplePricingRules {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category            String
  discount_percentage Decimal?  @default(dbgenerated("0")) @db.Decimal
  discount_amount     Decimal?  @default(dbgenerated("0")) @db.Decimal
  rule_name           String?
  status              String?   @default(dbgenerated("'active'::text"))
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  cash_discount_type  String?   @default(dbgenerated("'on_base_price'::text"))
  cash_discount_value Decimal?  @default(dbgenerated("0")) @db.Decimal
  cash_discount_mode  String?   @default(dbgenerated("'percentage'::text"))

  @@map("apple_pricing_rules")
  @@schema("public")
}

model AppleProducts {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  part_number     String    @unique
  description     String
  sap_description String?
  category        String
  subcategory     String?
  mrp             Decimal   @default(dbgenerated("0")) @db.Decimal
  alp_ex_vat      Decimal   @default(dbgenerated("0")) @db.Decimal
  gst_percentage  Decimal?  @default(dbgenerated("18")) @db.Decimal
  is_new          Boolean?  @default(dbgenerated("false"))
  status          String?   @default(dbgenerated("'active'::text"))
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@map("apple_products")
  @@schema("public")
}

model AttendanceRecords {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  employee_id String           @db.Uuid
  check_in    DateTime?        @db.Timestamptz(6)
  check_out   DateTime?        @db.Timestamptz(6)
  date        DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  device_id   String?
  source      AttendanceSource @default(dbgenerated("'manual'::attendance_source"))
  status      String           @default(dbgenerated("'present'::text"))
  notes       String?
  created_by  String?          @db.Uuid
  created_at  DateTime         @default(now()) @db.Timestamptz(6)

  @@map("attendance_records")
  @@schema("public")
}

model BusinessSettings {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  company_name        String?
  company_address     String?
  company_phone       String?
  company_email       String?
  gst_number          String?
  logo_url            String?
  invoice_prefix      String?  @default(dbgenerated("'INV-'::text"))
  quotation_prefix    String?  @default(dbgenerated("'QT-'::text"))
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @db.Timestamptz(6)
  integrations        Json?    @default(dbgenerated("'{}'::jsonb")) @db.JsonB
  timezone            String?  @default(dbgenerated("'Asia/Kolkata'::text"))
  gst_state_code      String?
  gst_type            String?  @default(dbgenerated("'regular'::text"))
  default_cgst_rate   Decimal? @default(dbgenerated("9")) @db.Decimal
  default_sgst_rate   Decimal? @default(dbgenerated("9")) @db.Decimal
  default_igst_rate   Decimal? @default(dbgenerated("18")) @db.Decimal
  hsn_default         String?
  whatsapp_api_url    String?
  whatsapp_api_key    String?
  whatsapp_phone_id   String?
  bank_name           String?
  bank_account_number String?
  bank_ifsc           String?
  bank_branch         String?
  bank_upi_id         String?

  @@map("business_settings")
  @@schema("public")
}

model CalendarEvents {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title           String
  description     String?
  start_date      DateTime  @db.Timestamptz(6)
  end_date        DateTime? @db.Timestamptz(6)
  all_day         Boolean?  @default(dbgenerated("false"))
  category        String?   @default(dbgenerated("'business'::text"))
  color           String?
  created_by      String?   @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  auth_created_by AuthUser? @relation("calendar_events_created_by_fkey", fields: [created_by], references: [id])

  @@map("calendar_events")
  @@schema("public")
}

model ChatConversations {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type             String         @default(dbgenerated("'internal'::text"))
  title            String?
  participant_ids  String[]       @default(dbgenerated("'{}'::uuid[]")) @db.Uuid
  last_message     String?
  last_message_at  DateTime?      @db.Timestamptz(6)
  created_by       String?        @db.Uuid
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  channel          String?        @default(dbgenerated("'internal'::text"))
  whatsapp_phone   String?
  rl_chat_messages ChatMessages[] @relation(name: "chat_messages_conversation_id_fkey")
  auth_created_by  AuthUser?      @relation("chat_conversations_created_by_fkey", fields: [created_by], references: [id])

  @@map("chat_conversations")
  @@schema("public")
}

model ChatMessages {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id      String            @db.Uuid
  sender_id            String?           @db.Uuid
  content              String
  read_at              DateTime?         @db.Timestamptz(6)
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  channel              String?           @default(dbgenerated("'internal'::text"))
  whatsapp_message_id  String?
  delivery_status      String?
  file_url             String?
  file_name            String?
  file_type            String?
  delivered_at         DateTime?         @db.Timestamptz(6)
  r_chat_conversations ChatConversations @relation(name: "chat_messages_conversation_id_fkey", fields: [conversation_id], references: [id], onDelete: Cascade)
  auth_sender_id       AuthUser?         @relation("chat_messages_sender_id_fkey", fields: [sender_id], references: [id])

  @@map("chat_messages")
  @@schema("public")
}

model ChecklistTemplates {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  issue_category_id  String?          @db.Uuid
  stage              String           @default(dbgenerated("'pre'::text"))
  title              String
  type               String?          @default(dbgenerated("'boolean'::text"))
  is_required        Boolean?         @default(dbgenerated("false"))
  sort_order         Int?             @default(dbgenerated("0"))
  options            Json?            @db.JsonB
  created_at         DateTime?        @default(now()) @db.Timestamptz(6)
  r_issue_categories IssueCategories? @relation(name: "checklist_templates_issue_category_id_fkey", fields: [issue_category_id], references: [id], onDelete: Cascade)

  @@map("checklist_templates")
  @@schema("public")
}

model Customers {
  id                                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                String
  phone                               String?
  email                               String?
  gst_number                          String?
  address                             String?
  city                                String?
  state                               String?
  pincode                             String?
  notes                               String?
  created_by                          String?               @db.Uuid
  created_at                          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                          DateTime              @default(now()) @db.Timestamptz(6)
  user_id                             String?               @db.Uuid
  avatar_url                          String?
  shipping_address                    String?
  shipping_city                       String?
  shipping_state                      String?
  shipping_pincode                    String?
  rl_delivery_challans_customer_id    DeliveryChallans[]    @relation(name: "delivery_challans_customer_id_fkey")
  rl_finance_transactions_customer_id FinanceTransactions[] @relation(name: "finance_transactions_customer_id_fkey")
  rl_invoices_customer_id             Invoices[]            @relation(name: "invoices_customer_id_fkey")
  rl_job_sheets_customer_id           JobSheets[]           @relation(name: "job_sheets_customer_id_fkey")
  rl_leads                            Leads[]               @relation(name: "leads_converted_customer_id_fkey")
  rl_payment_register_customer_id     PaymentRegister[]     @relation(name: "payment_register_customer_id_fkey")
  rl_payments_customer_id             Payments[]            @relation(name: "payments_customer_id_fkey")
  rl_pos_transactions_customer_id     PosTransactions[]     @relation(name: "pos_transactions_customer_id_fkey")
  rl_quotations_customer_id           Quotations[]          @relation(name: "quotations_customer_id_fkey")
  rl_repair_tickets_customer_id       RepairTickets[]       @relation(name: "repair_tickets_customer_id_fkey")
  auth_created_by                     AuthUser?             @relation("customers_created_by_fkey", fields: [created_by], references: [id])

  @@index([user_id], map: "idx_customers_user_id")
  @@map("customers")
  @@schema("public")
}

model DailyCashControl {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date                    DateTime  @unique @db.Date
  opening_cash            Decimal   @default(dbgenerated("0")) @db.Decimal
  previous_closing        Decimal?  @db.Decimal
  opening_override_reason String?
  closing_cash            Decimal?  @db.Decimal
  difference              Decimal?  @db.Decimal
  staff_name              String?
  created_by              String?   @db.Uuid
  created_at              DateTime  @default(now()) @db.Timestamptz(6)
  notes                   String?
  denominations           Json?     @db.JsonB
  pos_total               Decimal?  @default(dbgenerated("0")) @db.Decimal
  auto_income             Decimal?  @default(dbgenerated("0")) @db.Decimal
  manual_income           Decimal?  @default(dbgenerated("0")) @db.Decimal
  auto_expense            Decimal?  @default(dbgenerated("0")) @db.Decimal
  manual_expense          Decimal?  @default(dbgenerated("0")) @db.Decimal
  transfer_in             Decimal?  @default(dbgenerated("0")) @db.Decimal
  transfer_out            Decimal?  @default(dbgenerated("0")) @db.Decimal
  expected_closing        Decimal?  @db.Decimal
  status                  String?   @default(dbgenerated("'open'::text"))
  closed_by               String?   @db.Uuid
  closed_at               DateTime? @db.Timestamptz(6)
  reopened_by             String?   @db.Uuid
  reopened_at             DateTime? @db.Timestamptz(6)

  @@map("daily_cash_control")
  @@schema("public")
}

model DeliveryChallanItems {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challan_id          String           @db.Uuid
  product_id          String?          @db.Uuid
  product_name        String           @default(dbgenerated("''::text"))
  description         String?
  quantity            Int?             @default(dbgenerated("1"))
  unit_price          Decimal?         @default(dbgenerated("0")) @db.Decimal
  discount_type       String?          @default(dbgenerated("'percentage'::text"))
  discount_value      Decimal?         @default(dbgenerated("0")) @db.Decimal
  total               Decimal?         @default(dbgenerated("0")) @db.Decimal
  hsn_code            String?
  gst_percentage      Decimal?         @default(dbgenerated("18")) @db.Decimal
  gst_amount          Decimal?         @default(dbgenerated("0")) @db.Decimal
  image_url           String?
  sort_order          Int              @default(dbgenerated("0"))
  r_products          Products?        @relation(name: "delivery_challan_items_product_id_fkey", fields: [product_id], references: [id])
  r_delivery_challans DeliveryChallans @relation(name: "delivery_challan_items_challan_id_fkey", fields: [challan_id], references: [id], onDelete: Cascade)

  @@map("delivery_challan_items")
  @@schema("public")
}

model DeliveryChallans {
  id                        String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  challan_number            String                 @default(dbgenerated("''::text"))
  public_token              String                 @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customer_id               String?                @db.Uuid
  quotation_id              String?                @db.Uuid
  invoice_id                String?                @db.Uuid
  job_sheet_id              String?                @db.Uuid
  challan_type              String                 @default(dbgenerated("'delivery'::text"))
  status                    String                 @default(dbgenerated("'draft'::text"))
  show_pricing              Boolean                @default(dbgenerated("true"))
  show_item_images          Boolean                @default(dbgenerated("false"))
  shipping_address          String?
  courier_name              String?
  tracking_number           String?
  tracking_url              String?
  eway_bill_number          String?
  dispatched_at             DateTime?              @db.Timestamptz(6)
  expected_delivery_at      DateTime?              @db.Timestamptz(6)
  delivered_at              DateTime?              @db.Timestamptz(6)
  notes                     String?
  created_by                String?                @db.Uuid
  created_at                DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?              @default(now()) @db.Timestamptz(6)
  delivery_person           String?
  vehicle_number            String?
  receiver_name             String?
  receiver_phone            String?
  receiver_signature        String?
  pod_photo_url             String?
  gst_inclusive             Boolean?               @default(dbgenerated("false"))
  discount_type             String?                @default(dbgenerated("'percentage'::text"))
  discount_value            Decimal?               @default(dbgenerated("0")) @db.Decimal
  subtotal                  Decimal?               @default(dbgenerated("0")) @db.Decimal
  gst_amount                Decimal?               @default(dbgenerated("0")) @db.Decimal
  total                     Decimal?               @default(dbgenerated("0")) @db.Decimal
  deduct_stock              Boolean                @default(dbgenerated("true"))
  stock_deducted_at         DateTime?              @db.Timestamptz(6)
  stock_reversed_at         DateTime?              @db.Timestamptz(6)
  timeline                  Json?                  @default(dbgenerated("'[]'::jsonb")) @db.JsonB
  r_customers               Customers?             @relation(name: "delivery_challans_customer_id_fkey", fields: [customer_id], references: [id])
  r_quotations              Quotations?            @relation(name: "delivery_challans_quotation_id_fkey", fields: [quotation_id], references: [id])
  r_invoices                Invoices?              @relation(name: "delivery_challans_invoice_id_fkey", fields: [invoice_id], references: [id])
  r_job_sheets              JobSheets?             @relation(name: "delivery_challans_job_sheet_id_fkey", fields: [job_sheet_id], references: [id])
  rl_delivery_challan_items DeliveryChallanItems[] @relation(name: "delivery_challan_items_challan_id_fkey")

  @@map("delivery_challans")
  @@schema("public")
}

model Departments {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  device_department_id String?
  parent_id            String?           @db.Uuid
  device_id            String?           @db.Uuid
  created_at           DateTime          @default(now()) @db.Timestamptz(6)
  r_hikvision_devices  HikvisionDevices? @relation(name: "departments_device_id_fkey", fields: [device_id], references: [id])
  r_departments        Departments?      @relation(name: "departments_parent_id_fkey", fields: [parent_id], references: [id])
  rl_departments       Departments[]     @relation(name: "departments_parent_id_fkey")
  rl_employees         Employees[]       @relation(name: "employees_department_id_fkey")

  @@map("departments")
  @@schema("public")
}

model DeviceBrands {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("device_brands")
  @@schema("public")
}

model DeviceTypes {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String   @unique
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("device_types")
  @@schema("public")
}

model DeviceModels {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brand           String
  device_type     String
  name            String
  series          String?
  color_options   Json?    @default(dbgenerated("'[]'::jsonb")) @db.JsonB
  storage_options Json?    @default(dbgenerated("'[]'::jsonb")) @db.JsonB
  sort_order      Int      @default(0)
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([brand, device_type, name])
  @@map("device_models")
  @@schema("public")
}

model EmployeeAdvances {
  id                     String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  advance_number         String                     @default(dbgenerated("''::text"))
  employee_id            String                     @db.Uuid
  amount                 Decimal                    @db.Decimal
  recovered_amount       Decimal                    @default(dbgenerated("0")) @db.Decimal
  remaining_amount       Decimal                    @db.Decimal
  advance_date           DateTime                   @default(dbgenerated("CURRENT_DATE")) @db.Date
  payment_mode           String                     @default(dbgenerated("'cash'::text"))
  account_id             String?                    @db.Uuid
  status                 String                     @default(dbgenerated("'active'::text"))
  reason                 String?
  notes                  String?
  finance_transaction_id String?                    @db.Uuid
  staff_name             String?
  created_by             String?                    @db.Uuid
  created_at             DateTime                   @default(now()) @db.Timestamptz(6)
  r_employees            Employees                  @relation(name: "employee_advances_employee_id_fkey", fields: [employee_id], references: [id], onDelete: Cascade)
  r_finance_accounts     FinanceAccounts?           @relation(name: "employee_advances_account_id_fkey", fields: [account_id], references: [id])
  rl_payroll_recoveries  PayrollAdvanceRecoveries[] @relation(name: "payroll_advance_recoveries_advance_id_fkey")

  @@map("employee_advances")
  @@schema("public")
}

model Employees {
  id                                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                  String?                    @db.Uuid
  name                                     String
  phone                                    String?
  email                                    String?
  role                                     String?                    @default(dbgenerated("'staff'::text"))
  department                               String?
  designation                              String?
  salary                                   Decimal?                   @default(dbgenerated("0")) @db.Decimal
  joining_date                             DateTime?                  @db.Date
  status                                   String?                    @default(dbgenerated("'active'::text"))
  created_at                               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at                               DateTime                   @default(now()) @db.Timestamptz(6)
  avatar_url                               String?
  department_id                            String?                    @db.Uuid
  device_employee_code                     String?
  employee_type                            String?                    @default(dbgenerated("'internal'::text"))
  r_departments                            Departments?               @relation(name: "employees_department_id_fkey", fields: [department_id], references: [id])
  rl_employee_advances_employee_id         EmployeeAdvances[]         @relation(name: "employee_advances_employee_id_fkey")
  rl_hikvision_attendance_logs_employee_id HikvisionAttendanceLogs[]  @relation(name: "hikvision_attendance_logs_employee_id_fkey")
  rl_hikvision_employee_mapping            HikvisionEmployeeMapping[] @relation(name: "hikvision_employee_mapping_erp_employee_id_fkey")
  rl_payroll_employee_id                   Payroll[]                  @relation(name: "payroll_employee_id_fkey")

  @@map("employees")
  @@schema("public")
}

model FinanceAccounts {
  id                                    String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                  String
  type                                  String                @default(dbgenerated("'cash'::text"))
  account_number                        String?
  bank_name                             String?
  opening_balance                       Decimal               @default(dbgenerated("0")) @db.Decimal
  current_balance                       Decimal               @default(dbgenerated("0")) @db.Decimal
  status                                String                @default(dbgenerated("'active'::text"))
  created_by                            String?               @db.Uuid
  created_at                            DateTime              @default(now()) @db.Timestamptz(6)
  updated_at                            DateTime              @default(now()) @db.Timestamptz(6)
  rl_employee_advances_account_id       EmployeeAdvances[]    @relation(name: "employee_advances_account_id_fkey")
  rl_finance_transactions_account_id    FinanceTransactions[] @relation(name: "finance_transactions_account_id_fkey")
  rl_finance_transactions_to_account_id FinanceTransactions[] @relation(name: "finance_transactions_to_account_id_fkey")
  rl_payroll_account_id                 Payroll[]             @relation(name: "payroll_account_id_fkey")

  @@map("finance_accounts")
  @@schema("public")
}

model FinanceAuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  action      String
  entity_type String?
  entity_id   String?  @db.Uuid
  details     String?
  staff_name  String?
  user_id     String?  @db.Uuid
  user_role   String?
  ip_address  String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@map("finance_audit_log")
  @@schema("public")
}

model FinanceCategories {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                    String
  type                    String
  status                  String                @default(dbgenerated("'active'::text"))
  created_at              DateTime              @default(now()) @db.Timestamptz(6)
  rl_finance_transactions FinanceTransactions[] @relation(name: "finance_transactions_category_id_fkey")

  @@map("finance_categories")
  @@schema("public")
}

model FinanceTransactions {
  id                               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transaction_id                   String             @default(dbgenerated("''::text"))
  type                             String
  entry_source                     String             @default(dbgenerated("'manual'::text"))
  source_id                        String?
  date                             DateTime           @default(dbgenerated("CURRENT_DATE")) @db.Date
  daily_cash_date                  DateTime?          @db.Date
  amount                           Decimal            @db.Decimal
  payment_mode                     String?
  account_id                       String?            @db.Uuid
  to_account_id                    String?            @db.Uuid
  category_id                      String?            @db.Uuid
  customer_id                      String?            @db.Uuid
  reference                        String?
  description                      String?
  attachment_url                   String?
